# Copy this file to .env and adjust the values (install.sh does this for you).
# All paths are PORTABLE: no machine-specific absolute paths required.

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (single-node / demo default). Relative URLs resolve against prisma/.
DATABASE_URL=file:../db/custom.db
# PostgreSQL is NOT supported yet (raw SQL uses the SQLite dialect) — see docs/SUPPORT.md.

# ── Sentinel runtime ────────────────────────────────────────────────────────
# demo = simulation engine allowed (out-of-the-box demo data)
# live = real ingestion only; the simulation code path never starts
# SENTINEL_MODE=demo

# Which process owns the background loops (engine tick, schedulers):
#   all    = single process (default; dev + simple installs)
#   web    = HTTP only (docker-compose runs the worker separately)
#   worker = loops only (worker entrypoint refuses to start in web role)
# SENTINEL_ROLE=all

# Root for generated artefacts (reports). Default: ./data — set it explicitly
# in production (docker-compose mounts a volume here).
# SENTINEL_DATA_DIR=./data

# ── Live mode ─────────────────────────────────────────────────────
# Seconds between ingestion polls of the Prometheus HTTP API (min 5).
# SENTINEL_POLL_INTERVAL_SEC=15
# Consecutive failed probes before a live incident opens.
# SENTINEL_FAILURE_THRESHOLD=3
# Consecutive successful probes before a live incident resolves.
# SENTINEL_SUCCESS_THRESHOLD=2
# Bearer secret the Alertmanager webhook requires (≥16 chars). Generate with:
#   openssl rand -hex 24
# The same value goes into alertmanager.yml → receivers[].http_config.bearer_token.
# SENTINEL_WEBHOOK_BEARER=

# ── PDF report pipeline (WeasyPrint) ────────────────────────────────────────
# Python interpreter that has WeasyPrint installed. install.sh creates .venv
# and writes the absolute path here. Manual setup:
#   python3 -m venv .venv && .venv/bin/pip install -r reports/requirements.txt
# REPORT_PYTHON=/absolute/path/to/repo/.venv/bin/python3

# ── Optional LLM post-mortems (any OpenAI-compatible endpoint) ──────────────
# Unset = the built-in rule-based post-mortem is used (labelled as such).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_API_KEY=

# ── HTTP ─────────────────────────────────────────────────────────────────────
# PORT=3000

# ── Notifications ──────────────────────────────────────────────────
# Transport: auto = real adapters in live mode / offline bookkeeping in demo.
# Force with simulate (air-gapped) or real.
# SENTINEL_NOTIFY_TRANSPORT=auto
# Bot tokens — IntegrationSetting keys (Settings → Integrations) win over these.
# SENTINEL_TELEGRAM_BOT_TOKEN=
# SENTINEL_BALE_BOT_TOKEN=
# API bases — override for self-hosted Bot API / air-gapped installs / tests.
# SENTINEL_TELEGRAM_API_BASE=https://api.telegram.org
# SENTINEL_BALE_API_BASE=https://tapi.bale.ai
# HMAC secret (≥32 chars) enabling signed /ack links + the bot ack button.
#   openssl rand -hex 32
# SENTINEL_ACK_SECRET=
# Public origin embedded in ack links (defaults to http://localhost:PORT).
# SENTINEL_PUBLIC_BASE_URL=https://sentinel.example.ir
# Secret the Telegram/Bale callback webhook requires (X-Telegram-Bot-Api-Secret-Token).
# SENTINEL_TELEGRAM_WEBHOOK_SECRET=
# Minimal-SMTP email adapter (host unset = email channel reports not-configured).
# SENTINEL_SMTP_HOST=
# SENTINEL_SMTP_PORT=587
# SENTINEL_SMTP_USER=
# SENTINEL_SMTP_PASS=
# SENTINEL_SMTP_FROM=sentinel@example.ir
# SENTINEL_SMTP_IMPLICIT_TLS=0
