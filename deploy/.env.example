# Copy this file to deploy/.env. Docker Compose reads it automatically.

# Grafana admin password. Default when unset: sentinel-admin
GRAFANA_ADMIN_PASSWORD=change-me

# Bearer API token for the Go exporter (sentinel-exporter). Required since
# v2.0.0: the dashboard API refuses unauthenticated reads, and without a
# token the exporter emits no sentinel_* metrics. Mint one from the repo
# root, then paste it here:
#   bun scripts/mint-loadtest-token.mjs --name exporter --days 365
# Revoke with: bun scripts/mint-loadtest-token.mjs --revoke --name exporter
SENTINEL_API_TOKEN=
