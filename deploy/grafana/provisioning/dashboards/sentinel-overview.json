        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (sentinel_sla_penalty_tomans_total{service=~\"$service\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
